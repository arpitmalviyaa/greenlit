NEXT_PUBLIC_APP_URL=https://your-greenlit-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_SERVICE_ROLE_KEY=
GREENLIT_JWT_SECRET=
GREENLIT_ENV=production

# At least one is required. Do not set placeholders in production.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required before live users. `manual` is non-live only; use `api` after wiring
# an authenticated upstream email adapter that posts normalized messages to /api/email/ingest.
GREENLIT_QUEUE_NAME=greenlit-background-jobs
GREENLIT_EMAIL_PROVIDER=api
GREENLIT_STORAGE_BUCKET=contracts
GREENLIT_RATE_LIMIT_PER_MINUTE=120
GREENLIT_REQUEST_TIMEOUT_SECONDS=30
DEBUG=false

# Optional but recommended.
SENTRY_DSN=

# Required together when billing is enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_FREE=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_AGENCY=
RAZORPAY_PLAN_ID_ENTERPRISE=
