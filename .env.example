NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GREENLIT_JWT_SECRET=
GREENLIT_ENV=development

# At least one AI provider is required for production review flows.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local defaults are shown explicitly so strict production checks do not rely on hidden fallbacks.
GREENLIT_QUEUE_NAME=greenlit-background-jobs
GREENLIT_EMAIL_PROVIDER=manual
GREENLIT_STORAGE_BUCKET=contracts
GREENLIT_RATE_LIMIT_PER_MINUTE=120
GREENLIT_REQUEST_TIMEOUT_SECONDS=30
DEBUG=false

# Optional observability.
SENTRY_DSN=

# Configure all Razorpay values together when billing is enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_FREE=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_AGENCY=
RAZORPAY_PLAN_ID_ENTERPRISE=
