{
  "name": "greenlit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib proxy.ts instrumentation.ts",
    "type-check": "tsc --noEmit",
    "test:phase24-25": "node --test tests/phase24-25.test.mjs",
    "test:phase26-28": "node --test tests/phase26-28.test.mjs",
    "test:phase29-30": "node --test tests/phase29-30.test.mjs",
    "test:phases": "npm run test:phase24-25 && npm run test:phase26-28 && npm run test:phase29-30",
    "test:unit": "npm run test:phase24-25 && npm run test:ai-schemas",
    "test:integration": "npm run test:phase26-28 && npm run test:phase29-30",
    "test:e2e:live": "node scripts/live-functionality-audit.mjs",
    "test:backend-audit": "node --test tests/backend-audit.test.mjs",
    "test:auth": "node --test tests/auth-flows.test.mjs && node tests/session-cookies.test.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "migration:audit": "node scripts/migration-audit.mjs",
    "supabase:audit": "node scripts/supabase-audit.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "deps:audit": "npm audit --audit-level=high",
    "bundle:report": "node scripts/bundle-report.mjs",
    "performance:audit": "node scripts/performance-audit.mjs",
    "smoke": "node scripts/smoke-tests.mjs",
    "env:check": "node scripts/check-env.mjs",
    "verify:nonlive": "node scripts/verify-nonlive.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:ai-schemas": "node --test tests/redflags-schema.test.mjs",
    "qa:cross-tenant": "node scripts/qa-cross-tenant.mjs",
    "qa:prod-flow": "node scripts/qa-prod-flow.mjs",
    "test:corpus": "node --test tests/corpus-chunk.test.mjs && node --test --import ./tests/helpers/register-loader.mjs tests/compliance-grounding.test.mjs tests/export-gate.test.mjs",
    "corpus:eval": "npx tsx scripts/corpus-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.6",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.9",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
